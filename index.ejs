<!DOCTYPE html>
<html lang="zh">

<head>
    <meta charset="utf-8" />
    <title>三角洲地图站</title>
    <meta content="yes" name="apple-mobile-web-app-capable" />
     <meta name="robots" content="all" />
    <meta name="author" content="Tencent-CP" />
    <meta name="Copyright" content="Tencent" />
    <meta name="Keywords" content="三角洲行动,三角洲特种部队,Delta Force,三角洲新游,三角洲特种部队新游,Delta Force新游,新游预约,DF预约,DF奖励,新游奖励,三角洲绿洲营地,绿洲营地三角洲" />
    <meta id="share-description" itemprop="description" name="description"
      content="“G.T.I. Security”为《三角洲行动》项目组联合游戏安全团队特别成立的专门负责对抗违规行为的安全分队，为游戏环境安全保驾护航！" />
    <meta id="share-name" itemprop="name" content="" />
    <meta id="share-image" itemprop="image" content="" />
    <meta name="viewport"
    content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <link rel="icon" href="<%= require('./src/img/kf/favicon.ico') %>">
    <link rel="stylesheet" href="https://game.gtimg.cn/images/dfm/cp/a20240729directory/leaflet.css" crossorigin="" />
    <link rel="stylesheet" href="<%= require('./src/js/lib/Leaflet/L.Control.Zoomslider.css') %>" crossorigin="" />
    <!-- <script src="<%= require('./src/js/lib/Leaflet/leaflet-src.js') %>"></script> -->
    <script src="<%= require('./src/js/lib/leaflet.js') %>"></script>
    <script src="<%= require('./src/js/lib/Leaflet/L.Control.Zoomslider.js') %>"></script>
    <script src="<%= require('./src/js/lib/L.TileLayer.NoGap.js') %>"></script>
    <!-- <script src="<%= require('./src/js/lib/rbush.js') %>"></script> -->
    <!-- <script src="<%= require('./src/js/lib/leaflet-markers-canvas.js') %>"></script> -->
    <% if (process.env.NODE_ENV==='handover' ) { %>
        <script>
            if (!/Android|webOS|iPhone|iPad|iPod|BlackBerry/i.test(navigator.userAgent)) {
                location.href = '//df.qq.com/cp/a20240531anticheat' + location.search
            }
       </script>
    <% } %>

    <script type="text/javascript"><%= require('raw-loader!./src/js/app/rem.js') %></script>

    <!-- <script src="//cdn.jsdelivr.net/npm/eruda"></script>
    <script>
      eruda.init();
    </script> -->

  <% if (process.env.NODE_ENV==='handover' ) { %>
    <% for (var css in htmlWebpackPlugin.files.css) { %>
      <% var cssFile=htmlWebpackPlugin.files.css[css] %>
      <link href="<%= cssFile %>" rel="stylesheet" />
    <% } %>
  <% } else { %>
    <% for (var css in htmlWebpackPlugin.files.css) { %>
      <% var cssFile=htmlWebpackPlugin.files.css[css].substr(htmlWebpackPlugin.files.publicPath.length); %>
      <link href="<%= cssFile %>" rel="stylesheet" />
    <% } %>
  <% } %>

  <!-- 页面设计：cp | 页面制作：cp | 创建：2023-07-13 -->
</head>

<body class="transition_none">
    <div class="content">
          <!-- full -->
        <div class="m-main-wrap full">
            <!-- 竖屏页 -->
            <!-- absf -->
            <div class="m-vertical absf">
                <!-- abcter -->
                <div class="m-wrap sizcover abcter page-swiper">
                
                    <div class="swiper-wrapper">
                      <div class="m-index absf">
                        <div id="MapContainer">
                          <div class="map-mask img_map_mask absf sizcover"></div>
                        </div>

                        <div class="marker-pop-ctn">
                          <div class="marker-name">哪里</div>
                          <div class="address">地点：<span class="address-name"></span></div>
                          <div class="btn-close-marker-pop"></div>
                        </div>

                         <!-- 切换地图 -->
                         <div class="curr-map-ctn">
                          <div class="curr-map-name-ctn">
                            <div class="curr-map-name">零号大坝</div>
                            <div class="curr-map-lv">普通</div>

                            <div class="zj-ctn">
                              <div class="zj-icon"></div>
                              <div class="zj-text">坠机事件</div>
                            </div>
                          </div>
                          <div class="btn-change-map-ctn ">
                            <div class="btn-change-map img_change_map"></div>
                            <div class="map-list-ctn">
                              <div class="map-list">
                                <div class="map-item map-item-0 action" data-index="0">零号大坝</div>
                                <div class="map-item map-item-1" data-index="1">长弓溪谷</div>
                                <div class="map-item map-item-2" data-index="2">航天基地</div>
                              </div>
                              <div class="map-lv-list">
                                  <div class="map-lv-item map-lv-item-0 action" data-lv="0">普通</div>
                                  <div class="map-lv-item map-lv-item-1" data-lv="1">机密</div>
                                  <div class="map-lv-item map-lv-item-2" data-lv="2">绝密</div>
                              </div>
                            </div>
                          </div>
                        </div>

                        <div class="btn-nav-state">
                          <div class="nav-state-icon img_nav_state"></div>
                        </div>
                        <div class="select-region-ctn">
                          <div class="btn-select-region img_nav_check"></div>
                          <div class="select-region">
                            <div class="check-line img_nav_check_line"></div>
                            <div class="check-title">快速定位</div>
                            <div class="region-list"></div>
                          </div>
                         
                        </div>
                    
                        <div class="nav-ctn ">
                          <div class="nav-ctn-bg img_nav_bg">
                            <div class="nav-title img_nav_title"></div>
                            
                            <!-- 搜索 -->
                            <div class="map-select">
                              <input type="text" class="select-iput" placeholder="搜索">
                              <div class="select-ctn">
          
                              </div>
                              <div class="btn-close-select"></div>
                              </div>
                           
          
                             <div class="choose-all img_all_close"></div>
                            <!-- 选项标签 -->
                            <div class="nav-option-ctn">
                              <div class="nav-options"></div>
                              <div class="nav-type-list"></div>
                        
                            </div>
                          </div>
                          <div class="nav-bot-ctn img_nav_bot_bg">
                            <div class="abcter reset-choose img_reset"></div>
                            <div class="abcter btn-check-marker img_btn_check_marker"></div>
                          </div>
                        </div>
        
                        <div class="right-nav">
                          <div class="btn-right-nav img_btn_right_nav"></div>
                          <div class="right-nav-bg img_right_nav_bg"></div>
                          <div class="btn-log"></div>
                          <div class="btn-share"></div>
                          <div class="btn-tutorial"></div>
                          <div class="btn-feedback"></div>
                        </div>
        
                        <!-- 弹窗 -->
                         <div class="log-pop">
                          <div class="log-pop-bg"></div>
                          <div class="abcter log-pop-ctn-bg img_log_pop">
                            <!-- <div class="log-title">更新日志</div> -->
                            <div class="log-pop-title">*温馨提示：坐标持续更新中，目前地图工具内坐标信息为双子测试版本。</div>
                            <div class="abcter log-pop-ctn">
                              <div class="log-item">
                                <div class="log-time">8月15日</div>
                                <div class="log-fgx img_pop_fgx"></div>
                                <div class="log-text">《三角洲行动》地图工具beta版正式上线，已更新零号大坝（普通）、零号大坝（机密）、长弓溪谷（普通）、长弓溪谷（机密）、航天基地（绝密）的物资点、出生点、撤离点及首领坐标。</div>
                              </div>
                            </div>
                            <div class="abcter btn-close-pop"></div>
                          </div>
                    
                         </div>

                         <div class="abcter m-toast">功能开发中，敬请期待</div>
        
                         <!-- 外链 -->
                          <div class="bottom-bar">
                            <div class="bottom-bar-bg"></div>
                            <div class="bottom-bar-ctn">
                              <div class="bottom-bar-list">
                                <div class="bottom-bar-item qq"></div>
                                <div class="bottom-bar-item kj"></div>
                                <div class="bottom-bar-item wb"></div>
                                <div class="bottom-bar-item wx"></div>
                                <div class="bottom-bar-item lj"></div>
                              </div>
                            </div>
                          </div>

                          <div class="share-tips">
                            <div class="share-tips-text"></div>
                          </div>
                      <% if (process.env.NODE_ENV !=='handover' ) { %>
                        <!-- 弹窗测试入口 -->
                        <div class="abs btn_test_rap"></div>
                      <% } %>
        
                    </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
  

  <script>
        window.isSupportWebp = false;//是否支持
        (function() {
            var img = new Image(); 
            function getResult(event) {
                //如果进入加载且图片宽度为1(通过图片宽度值判断图片是否可以显示)
                window.isSupportWebp = event && event.type === 'load' ? img.width == 1 : false;
            }
            img.onerror = getResult;
            img.onload = getResult;
            img.src = 'data:image/webp;base64,UklGRiQAAABXRUJQVlA4IBgAAAAwAQCdASoBAAEAAwA0JaQAA3AA/vuUAAA='; //一像素图片
        })();
  </script>

  <script src="<%= require('./src/js/lib/jquery-1.11.3.min.js') %>"></script>
  <script src="<%= require('./src/js/lib/map_article.js') %>"></script>
  <script src="<%= require('./src/js/lib/map_cgxg.js') %>"></script>
  <script src="<%= require('./src/js/lib/map_htjd.js') %>"></script>
  <script src="<%= require('./src/js/lib/main.js') %>"></script>
  <script src="https://ossweb-img.qq.com/images/js/TGMobileShare/TGMobileShare.min.js"></script>
  <script src="https://res.wx.qq.com/open/js/jweixin-1.3.2.js"></script>
  <script>
    //分享参数设置
    var shareParam = {
      shareTitle: '三角洲地图站站',
      shareDesc: '欢迎使用《三角洲行动》地图工具，您可使用本地图快速查询烽火行动模式中各地图的物资点位，帮助您在险象环生的战场中成功撤离。',
      shareImgUrl: `https://game.gtimg.cn/images/dfm/cp/a20240531anticheat/m/share.jpg`, //分享icon
      shareLink: '',
      actName: 'a20240531anticheat',
    };
    TGMobileShare({
      shareTitle: shareParam.shareTitle, //不设置或设置为空时，页面有title，则调取title
      shareDesc: shareParam.shareDesc, //不设置或设置为空时，页面有Description，则调取Description
      shareImgUrl: shareParam.shareImgUrl, //分享图片尺寸200*200，且填写绝对路径
      shareLink: shareParam.shareLink, //分享链接要跟当前页面同域名(手Q分享有这个要求) ,不设置或设置为空时，默认调取当前URL
      actName: shareParam.actName, //点击流命名，用于统计分享量，专题一般采用目录名称如a20151029demo
    });
    var setSite = {
      siteType: 'a20240531anticheat', //必填ame例701xxx
      pageType: 'index', //必填项:本页面的定位；按照页面含义填写例如main||list||detail||download||share||page1||pageN
      pageName: '主页', //必填项:页面中文名
      project: 'base', //选填项:如果是官网模块则是必填;按照模块内容，填写固定的对应值;原生官网base;微社区ingame;同人站doujin;赛事match;故事站story;文化站history;粉丝站fans;爆料站coming;论坛bbs;默认other;
      osact: !!navigator.userAgent.match(/AppleWebKit.*Mobile.*/) ? 'm' : 'pc', //选填项:默认是0。osact=0表示非官网专题；osact=pc表示pc官网/pc官网专题；osact=m表示移动官网/移动官网专题；osact=ingame表示微社区/微社区专题
    };
    if (typeof pgvMain == 'function') pgvMain();

    if (wx) {
      wx.miniProgram.getEnv(function(res) { 
        if (res.miniprogram) {
          $('.share-tips').addClass('webview')
        }
      })
    }

    if (window.location.href.indexOf('webview') > 0) {
      $('.share-tips').addClass('webview')
    }



  </script>
  <% if (process.env.NODE_ENV==='handover' ) { %>
    <% for (var chunk in htmlWebpackPlugin.files.chunks) { %>
      <% var jsFile=htmlWebpackPlugin.files.chunks[chunk].entry; %>
        <script type="text/javascript" src="<%= jsFile %>"></script>
    <% } %>
  <% } else { %>
    <% for (var chunk in htmlWebpackPlugin.files.chunks) { %>
      <% var jsFile=htmlWebpackPlugin.files.chunks[chunk].entry.substr(htmlWebpackPlugin.files.publicPath.length);%>
      <script type="text/javascript" src="<%= jsFile %>"></script>
    <% } %>
  <% } %>
</body>

</html>