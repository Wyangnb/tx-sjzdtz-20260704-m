  <script>
    //分享参数设置
    var shareParam = {
      shareTitle: '三角洲地图站站',
      shareDesc: '欢迎使用《三角洲行动》地图工具，您可使用本地图快速查询烽火行动模式中各地图的物资点位，帮助您在险象环生的战场中成功撤离。',
      shareImgUrl: `https://game.gtimg.cn/images/dfm/cp/a20240531anticheat/m/share.jpg`, //分享icon
      shareLink: '',
      actName: 'a20240531anticheat',
    };
    TGMobileShare({
      shareTitle: shareParam.shareTitle, //不设置或设置为空时，页面有title，则调取title
      shareDesc: shareParam.shareDesc, //不设置或设置为空时，页面有Description，则调取Description
      shareImgUrl: shareParam.shareImgUrl, //分享图片尺寸200*200，且填写绝对路径
      shareLink: shareParam.shareLink, //分享链接要跟当前页面同域名(手Q分享有这个要求) ,不设置或设置为空时，默认调取当前URL
      actName: shareParam.actName, //点击流命名，用于统计分享量，专题一般采用目录名称如a20151029demo
    });
    var setSite = {
      siteType: 'a20240531anticheat', //必填ame例701xxx
      pageType: 'index', //必填项:本页面的定位；按照页面含义填写例如main||list||detail||download||share||page1||pageN
      pageName: '主页', //必填项:页面中文名
      project: 'base', //选填项:如果是官网模块则是必填;按照模块内容，填写固定的对应值;原生官网base;微社区ingame;同人站doujin;赛事match;故事站story;文化站history;粉丝站fans;爆料站coming;论坛bbs;默认other;
      osact: !!navigator.userAgent.match(/AppleWebKit.*Mobile.*/) ? 'm' : 'pc', //选填项:默认是0。osact=0表示非官网专题；osact=pc表示pc官网/pc官网专题；osact=m表示移动官网/移动官网专题；osact=ingame表示微社区/微社区专题
    };
    if (typeof pgvMain == 'function') pgvMain();

    if (wx) {
      wx.miniProgram.getEnv(function(res) { 
        if (res.miniprogram) {
          $('.share-tips').addClass('webview')
        }
      })
    }

    if (window.location.href.indexOf('webview') > 0) {
      $('.share-tips').addClass('webview')
    }

    if (window.location.href.indexOf('pix') > 0) {
      $('.m-vertical').addClass('pix')
    }

    // 返回游戏
    $('.btn-back-game').on('click', function() {
      msdkCall('{"MsdkMethod":"closeWebView","key":"value"}')
    })



  </script>
  <% if (process.env.NODE_ENV==='handover' ) { %>
    <% for (var chunk in htmlWebpackPlugin.files.chunks) { %>
      <% var jsFile=htmlWebpackPlugin.files.chunks[chunk].entry; %>
        <script type="text/javascript" src="<%= jsFile %>"></script>
    <% } %>
  <% } else { %>
    <% for (var chunk in htmlWebpackPlugin.files.chunks) { %>
      <% var jsFile=htmlWebpackPlugin.files.chunks[chunk].entry.substr(htmlWebpackPlugin.files.publicPath.length);%>
      <script type="text/javascript" src="<%= jsFile %>"></script>
    <% } %>
  <% } %>
